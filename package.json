{
  "name": "paste-ops",
  "displayName": "Paste Ops",
  "description": "Apply file writes, patches, renames, deletes, and dirs from clipboard with preview, grouping, diffs, and selective apply",
  "publisher": "nighty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/paste-ops.git"
  },
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pasteOps.apply",
        "title": "Paste Ops: Apply File Operations from Clipboard"
      }
    ],
    "keybindings": [
      {
        "command": "pasteOps.apply",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ]
  }
}